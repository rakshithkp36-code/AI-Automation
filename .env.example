# FlowPilot AI Environment Variables

PORT=5000
NODE_ENV=development

# Database Configuration
# If DATABASE_URL is left empty, FlowPilot AI automatically uses its embedded persistent
# PostgreSQL engine (PGlite) stored in ./data/flowpilot_pg without requiring any external install!
# Or connect directly to any remote PostgreSQL / Supabase instance:
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=

# Google Gemini API Key
# FlowPilot AI uses @google/genai on the server.
# If left empty, FlowPilot runs in high-fidelity heuristic engine mode so all demo features work smoothly.
# To connect to live Google GenAI (gemini-2.5-flash), provide your API key below:
GEMINI_API_KEY=

# Authentication Session Secret
SESSION_SECRET=flowpilot-ai-hackathon-secure-session-key-2026
